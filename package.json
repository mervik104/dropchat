{
  "name": "dropchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DropChat - account-less data transfer with a messenger UI",
  "workspaces": [
    "shared",
    "worker",
    "drive-gateway",
    "web"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261101.1": true
  }
}
