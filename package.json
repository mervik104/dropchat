{
  "name": "dropchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DropChat - account-less data transfer with a messenger UI",
  "workspaces": [
    "shared",
    "worker",
    "drive-gateway",
    "web"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "coverage": "npm run coverage --workspaces --if-present && npm run coverage:scripts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present",
    "db:migrate:local": "npm run db:migrate:local --workspace @dropchat/worker",
    "smoke:discovery": "bash scripts/smoke-discovery.sh",
    "smoke:linking": "bash scripts/smoke-linking.sh",
    "test:scripts": "vitest run --config vitest.config.ts",
    "coverage:scripts": "vitest run --config vitest.config.ts --coverage",
    "dev:workers": "wrangler dev -c worker/wrangler.jsonc -c drive-gateway/wrangler.jsonc --persist-to .wrangler/state"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "@vitest/coverage-v8": "4.1.12"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261101.1": true
  }
}
