{
  "name": "@dropchat/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../.wrangler/state",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply dropchat --local --persist-to ../.wrangler/state"
  },
  "dependencies": {
    "@dropchat/shared": "0.1.0",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@vitest/coverage-istanbul": "4.1.12",
    "vitest": "4.1.12",
    "wrangler": "4.156.1"
  }
}
