{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropchat-worker",
  "main": "src/index.ts",
  "account_id": "c173801bc8323d3335bf5068b2295a73",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dropchat",
      "database_id": "12987b7d-7fcc-4af7-8e66-04040a0230fd",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Hub"]
    }
  ],
  "services": [
    {
      "binding": "DRIVE",
      "service": "dropchat-drive-gateway"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "CLOUD_UPLOADS_ENABLED": "true",
    "RETENTION_DAYS": "30",
    "MAX_FILE_SIZE": "53687091200",
    "PER_DEVICE_UPLOAD_PER_24H": "53687091200",
    "PER_DEVICE_STORED_TOTAL": "53687091200",
    "GLOBAL_STORED_TOTAL": "1099511627776",
    "FILE_COMPLETE_LIMIT_PER_HOUR": "100",
    "FILE_INIT_LIMIT_PER_HOUR": "50",
    "FILE_LINK_LIMIT_PER_MINUTE": "60",
    "FILE_PART_LIMIT_PER_MINUTE": "600",
    "INVITE_CREATE_LIMIT_PER_HOUR": "20",
    "INVITE_GLOBAL_FAILURE_LIMIT": "100",
    "INVITE_IP_GROUP_FAILURE_LIMIT": "20",
    "MAX_MESSAGE_LENGTH": "4000",
    "MAX_PENDING_PEER_REQUESTS": "10",
    "MESSAGE_LIMIT_PER_MINUTE": "60",
    "PEER_REQUEST_LIMIT_PER_HOUR": "20",
    "PEER_REQUEST_TTL_HOURS": "24",
    "PROFILE_UPDATE_LIMIT_PER_HOUR": "30",
    "REGISTRATION_LIMIT_PER_HOUR": "20",
    "WS_TICKET_LIMIT_PER_MINUTE": "30",
    "WEB_ORIGIN": "https://drop.mervik.ru"
  }
}
