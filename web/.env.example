# Dev UI uses the Vite proxy by default: /api -> http://127.0.0.1:8787.
# Leave VITE_API_URL unset for desktop and LAN/phone testing through the proxy.
# Set it only when the UI should call a Worker directly.
# VITE_API_URL=http://127.0.0.1:8787

# Static build base path. GitHub Pages uses /dropchat/.
# VITE_BASE=/
