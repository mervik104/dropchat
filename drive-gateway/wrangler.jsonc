{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropchat-drive-gateway",
  "main": "src/index.ts",
  "account_id": "c173801bc8323d3335bf5068b2295a73",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "TOKEN_KEEPER",
        "class_name": "TokenKeeper"
      },
      {
        "name": "SESSIONS",
        "class_name": "SessionStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TokenKeeper",
        "SessionStore"
      ]
    }
  ],
  "vars": {
    "TOKEN_REFRESH_DELAY_MS": "0"
  }
}
